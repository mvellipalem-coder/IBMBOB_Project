# =====================================================================
# Environment variables used by the EBookStore backend.
# This file is only a TEMPLATE with placeholders. Do NOT put real values here.
# Set real values in your shell, IDE run configuration, or a secrets manager.
# Real .env files are git-ignored. See docs/DATABASE_SETUP.md.
# =====================================================================

# --- Required in every profile (the app will not start without them) ---
DB_PASSWORD=<password-of-the-ebookstore_user-database-user>
JWT_SECRET=<random-string-of-at-least-32-characters>

# --- Required in the default and prod profiles; the dev profile has local defaults ---
DB_URL=jdbc:postgresql://localhost:5432/ebookstore_db
DB_USERNAME=ebookstore_user

# --- Optional ---
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
JWT_EXPIRATION_SECONDS=1800
CORS_ALLOWED_ORIGIN=http://localhost:5173