# =====================================================================
# Frontend settings (Vite). Copy to `.env.local` for local overrides; real .env files are git-ignored.
# Only variables starting with VITE_ are sent to the browser, so NEVER put secrets here.
# =====================================================================

# Base URL of the Spring Boot API, including /api. Must be HTTPS outside local development
# (production builds refuse a plain-http URL that is not localhost).
VITE_API_BASE_URL=http://localhost:8080/api

# Optional
VITE_REQUEST_TIMEOUT_MS=15000
VITE_CURRENCY=INR
VITE_LOCALE=en-IN
